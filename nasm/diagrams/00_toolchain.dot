digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="00 / WHO DOES WHAT";
s [label="source.asm\nInstructions, labels, directives"];
o [label="NASM -> object.o\nBytes + symbols + relocations"];
e [label="Linker -> ELF executable\nResolved addresses + entry point"];
l [label="Linux loader\nVirtual mappings + initial stack"];
c [label="CPU executes instructions\nRegisters + memory + flags"];
s -> o [label="assemble"];
o -> e [label="link"];
e -> l [label="execute file"];
l -> c [label="enter at ELF entry"];

}
