digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="03 / SAME WIDTH, DIFFERENT OVERFLOW QUESTIONS";
u [label="8-bit unsigned view\n255 + 1 = 256 (does not fit)"];
ur [label="Stored result: 0x00\nCF=1  OF=0  ZF=1"];
s [label="8-bit signed view\n127 + 1 = 128 (does not fit)"];
sr [label="Stored result: 0x80 = signed -128\nCF=0  OF=1  ZF=0"];
n [label="Flags belong to an operation\nA later CMP/XOR/ADD can replace them"];
u -> ur [label="add al, 1"];
s -> sr [label="add al, 1"];
ur -> n [label="read before clobber"];
sr -> n [label="read before clobber"];
{rank=same;u;s;} {rank=same;ur;sr;}
}
