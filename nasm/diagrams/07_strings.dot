digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="07 / TWO STRING CONTRACTS";
count [label="Counted byte span\nPointer + length = 4\nBytes: 41 00 42 0a"];
write [label="write sends all four bytes\nEmbedded NUL is ordinary data"];
nul [label="NUL-terminated C string\nPointer -> 41 00 42 0a"];
scan [label="strlen stops at first 00\nLength = 1; following bytes excluded"];
cap [label="Capacity is a separate bound\nNeither pointer nor terminator proves allocation size"];
count -> write [label="explicit length"];
nul -> scan [label="terminator convention"];
write -> cap [label=""];
scan -> cap [label=""];
{rank=same;count;nul;} {rank=same;write;scan;}
}
