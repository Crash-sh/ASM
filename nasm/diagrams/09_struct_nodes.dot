digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="09 / TWO NODES, ONE MAPPING";
base [label="R12 = mapping base\nRequested capacity = 32 bytes"];
a [label="Node 1 at base + 0\n+0: int value = 13 (4 bytes)\n+4: padding (4 bytes)\n+8: next pointer (8 bytes)"];
b [label="Node 2 at base + 16\n+0: int value = 53 (4 bytes)\n+4: padding (4 bytes)\n+8: next = NULL (8 bytes)"];
end [label="Sum = 66\nmunmap(base, 32)\nBoth nodes cease to be live objects"];
base -> a [label="first node"];
a -> b [label="next = base + 16"];
b -> end [label="NULL ends traversal"];

}
