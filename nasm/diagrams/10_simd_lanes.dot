digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="10 / FOUR INDEPENDENT DWORD ADDITIONS";
a [label="XMM0 input lanes\n13     |     53     |     689     |     -1"];
b [label="XMM1 input lanes\n1      |      2     |       3     |      4"];
r [label="PADDD result in XMM0\n14     |     55     |     692     |      3"];
h [label="Horizontal reduction is separate work\n14 + 55 + 692 + 3 = 764"];
t [label="Memory load width = 16 bytes\nUnaligned allowed does NOT mean out-of-bounds allowed"];
a -> r [label="lane-wise add"];
b -> r [label="no carry across lanes"];
r -> h [label="shifts + adds"];
h -> t [label=""];
{rank=same;a;b;}
}
