digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="11 / A LOST UPDATE NEEDS NO BROKEN CPU";
i [label="Initial counter = 13"];
a [label="Ordinary sequence\nA reads 13; B reads 13\nA computes 53; B computes 53\nA stores 53; B stores 53"];
b [label="Atomic fetch-add sequence\nA: old=13, memory becomes 53\nB: old=53, memory becomes 93"];
ar [label="Final counter = 53\nOne update lost"];
br [label="Final counter = 93\nCompound updates were indivisible"];
c [label="Atomic instruction semantics are only one part\nOrdering, lifetime, and algorithm still need reasoning"];
i -> a [label="no synchronization"];
i -> b [label="lock xadd"];
a -> ar [label=""];
b -> br [label=""];
ar -> c [label=""];
br -> c [label=""];
{rank=same;a;b;} {rank=same;ar;br;}
}
