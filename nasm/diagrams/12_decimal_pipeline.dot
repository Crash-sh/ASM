digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="12 / DECIMAL TEXT AND BINARY VALUE";
s [label="Input bytes: 36 38 39 00\nC string \"689\""];
p [label="Validate digits before accumulating\n0*10+6 = 6\n6*10+8 = 68\n68*10+9 = 689"];
n [label="Binary integer 689\nRAX = 0x2b1"];
d [label="Divide unsigned by 10\n689 -> quotient 68, remainder 9\n68  -> quotient 6, remainder 8\n6   -> quotient 0, remainder 6"];
b [label="Store remainder + ASCII zero backwards\nFinal bytes: 36 38 39 0a\nPointer + length 4 -> write_all"];
s -> p [label="input bound / terminator contract"];
p -> n [label="overflow checked before arithmetic"];
n -> d [label="clear RDX before each DIV"];
d -> b [label="one BYTE per digit"];

}
