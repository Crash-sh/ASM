digraph lesson {
  graph [bgcolor="#101827", fontname="DejaVu Sans", fontsize=22, fontcolor="#f1f5f9", pad=0.35, nodesep=0.35, ranksep=0.5, dpi=135, labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#20324b", color="#6583a8", fontcolor="#f1f5f9", fontname="DejaVu Sans", fontsize=14, margin="0.20,0.14", penwidth=1.3];
  edge [color="#55cfcb", fontcolor="#bcefe9", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8, penwidth=1.5];

rankdir=TB;
label="13 / SECTIONS ARE NOT SEGMENTS";
s [label="NASM object sections\n.text  .rodata  .data  .bss\nSymbols + relocations + debug information"];
l [label="Linker resolves references\nBuilds ELF headers and program headers"];
seg [label="PT_LOAD segments\nVirtual addresses, sizes, R/W/X permissions"];
mem [label="Linux maps process memory\nBSS receives zero-filled storage"];
g [label="GNU_STACK program header\nStack executable permission request"];
d [label="Inspect both views\nreadelf -S: sections\nreadelf -l: segments"];
s -> l [label="link"];
l -> seg [label="loadable image"];
seg -> mem [label="loader"];
l -> g [label="stack metadata"];
mem -> d [label=""];
g -> d [label=""];

}
